# ── 探测量层（v2）用到的密钥 ─────────────────────────────
# 豆包（火山方舟）：必须走 /api/v3/responses + web_search 工具才能拿到答案级引用
DOUBAO_KEY=
# 豆包联网搜索需要支持 web_search 的模型 / 推理接入点 id，按控制台实际值填
DOUBAO_MODEL=doubao-1-5-pro-32k

KIMI_KEY=
KIMI_SEARCH_MODEL=kimi-k2.6

DEEPSEEK_KEY=

# 智谱清言（open.bigmodel.cn → API Keys）
# 注意：必须选支持工具调用的模型，glm-4-flash 这类轻量模型可能直接 400
ZHIPU_KEY=
ZHIPU_MODEL=glm-4.5-air
# 搜索引擎对召回影响很大：search_pro 综合最稳；search_pro_sogou 覆盖公众号/知乎，
# 本地生活、医疗这类中文内容往往更全；search_pro_quark 偏垂直内容
# ZHIPU_BASE=https://open.bigmodel.cn/api/paas/v4/chat/completions

# 通义千问（阿里云百炼），QWEN_KEY 与 DASHSCOPE_KEY 任填其一
QWEN_KEY=
QWEN_MODEL=qwen-plus
# 默认走北京地域公网端点；若用业务空间专属域名，改成：
# https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/text-generation/generation
# QWEN_BASE=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation

# 文心一言（百度千帆）。两种凭据二选一：
# ① API Key 直连（推荐）：千帆控制台 → API Key，格式 bce-v3/ALTAK-xxx
#    注意：搜索增强只有 ERNIE 4.5 系模型支持
QIANFAN_API_KEY=
QIANFAN_MODEL=ernie-4.5-turbo-32k
# ② 老账号 AK/SK → OAuth 换 access_token（走 v1 接口，兜底用）
QIANFAN_AK=
QIANFAN_SK=
QIANFAN_ENDPOINT=ernie-4.5-8k-preview

# 腾讯元宝：无公开 API，只能浏览器自动化（L3）。
# 第一步（人工）：python scripts/yuanbao_login.py 弹出浏览器扫码登录
# 登录态存 backend/data/yuanbao_state.json（已在 .gitignore，等同凭据不要外传）
# YUANBAO_STATE 默认 backend/data/yuanbao_state.json
# YUANBAO_CHANNEL=chrome   （用系统 Chrome；留空则用 Playwright 内置 Chromium）
# YUANBAO_HEADLESS=true    （调试选择器时可设 false 看浏览器动作）
# YUANBAO_TIMEOUT_SEC=180

# 判定用模型：deepseek / kimi。没有 key 时自动退回纯规则判定
JUDGE_PROVIDER=deepseek

# ── 限流（每分钟调用上限），按账号配额调，别为了快把账号打爆 ──
RATE_DOUBAO=10
RATE_KIMI=20
RATE_DEEPSEEK=30
RATE_ZHIPU=20
RATE_QWEN=20
RATE_WENXIN=30
RATE_YUANBAO=4

# Optional: override the default SQLite database.
# 多租户/并发跑批建议换 PostgreSQL，SQLite 只适合单机验证
# DATABASE_URL=postgresql+psycopg2://user:pass@127.0.0.1:5432/geo
